{
  "schemaVersion": 2,
  "extensions": {
    "breakpoints": [
      {
        "name": "mobile-max",
        "value": "700px"
      },
      {
        "name": "narrow-max",
        "value": "360px"
      }
    ],
    "sourceFiles": [
      "public/ios.css",
      "public/navigation.css"
    ],
    "motion": "180ms; disabled for prefers-reduced-motion",
    "navigation": "64px dock, 12px bottom gap plus safe-area inset, 22px blur"
  },
  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "html": "<button class=\"ds-primary\">Save expense</button>",
      "css": ".ds-primary{background:var(--accent,#17634e);color:#fff;border:1px solid var(--accent,#17634e);border-radius:14px;min-height:48px;padding:12px 18px;font:600 15px system-ui}.ds-primary:hover{filter:brightness(.96)}.ds-primary:focus-visible{outline:2px solid var(--accent,#17634e);outline-offset:3px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "html": "<button class=\"ds-secondary\">Keep editing</button>",
      "css": ".ds-secondary{background:var(--surface,#fff);color:var(--ink,#172c28);border:1px solid var(--line,#dce4df);border-radius:14px;min-height:46px;padding:12px 16px;font:14px system-ui}.ds-secondary:hover{filter:brightness(.96)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#17634e);outline-offset:3px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "html": "<label class=\"ds-field\">Sheet name<input placeholder=\"September expenses\"></label>",
      "css": ".ds-field{display:grid;gap:7px;font:13px system-ui;color:var(--ink,#172c28)}.ds-field input{font:16px system-ui;padding:12px;background:var(--input,#f2f5f2);color:inherit;border:1px solid var(--line,#dce4df);border-radius:12px}.ds-field input:focus{outline:2px solid var(--accent,#17634e);outline-offset:2px}"
    },
    {
      "name": "Content surface",
      "kind": "card",
      "html": "<section class=\"ds-surface\">Your household journal</section>",
      "css": ".ds-surface{padding:20px;background:var(--surface,#fff);color:var(--ink,#172c28);border:1px solid var(--card-border,#e3e9e4);border-radius:22px;font:15px system-ui}"
    },
    {
      "name": "Glass navigation",
      "kind": "nav",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Home</button><button>Sheets</button><button>Settle</button><button>Settings</button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,1fr);padding:4px;height:64px;border-radius:999px;background:linear-gradient(155deg,#ffffffb8,#ffffff70 55%,#ffffffa0);border:1px solid #ffffffd9;backdrop-filter:blur(22px) saturate(1.7);box-shadow:0 8px 30px #18263720}.ds-nav button{border:0;border-radius:999px;background:transparent;color:#606670;font:600 11px system-ui;min-width:44px;min-height:44px}.ds-nav button[aria-current]{background:#25634d18;color:#17634e}.ds-nav button:hover{filter:brightness(.93)}.ds-nav button:focus-visible{outline:2px solid #17634e;outline-offset:2px}"
    }
  ],
  "narrative": {
    "overview": "A calm household journal. Compact content, legible monetary amounts, familiar iPhone controls, and floating translucent navigation.",
    "keyCharacteristics": [
      "Compact journal",
      "Green identity",
      "Glass navigation",
      "Light and dark themes"
    ]
  }
}
