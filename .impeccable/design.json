{
  "schemaVersion": 2,
  "extensions": {
    "breakpoints": [
      {
        "name": "sheet-max",
        "value": "650px"
      },
      {
        "name": "wide-min",
        "value": "700px"
      },
      {
        "name": "narrow-max",
        "value": "359px"
      }
    ],
    "sourceFiles": [
      "public/foundation.css",
      "public/screens.css",
      "public/home.css",
      "public/entry.css"
    ],
    "motion": "160ms / 320ms with cubic-bezier(.22,1,.36,1); disabled for prefers-reduced-motion",
    "navigation": "68px frosted dock with a sliding selection pill and a central ink Add button"
  },
  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "html": "<button class=\"ds-primary\">Save expense</button>",
      "css": ".ds-primary{background:var(--primary,#15161a);color:var(--primary-ink,#fff);border:0;border-radius:999px;min-height:50px;padding:12px 22px;font:600 15px Geist,system-ui}.ds-primary:focus-visible{outline:2px solid var(--focus,#17785a);outline-offset:2px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "html": "<button class=\"ds-secondary\">Keep editing</button>",
      "css": ".ds-secondary{background:var(--surface,#fff);color:var(--ink,#15161a);border:1px solid var(--line,#e4e2db);border-radius:999px;min-height:50px;padding:12px 22px;font:600 15px Geist,system-ui}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "html": "<label class=\"ds-field\">Sheet name<input placeholder=\"October expenses\"></label>",
      "css": ".ds-field{display:grid;gap:8px;font:500 14px Geist,system-ui;color:var(--ink-2,#52565e)}.ds-field input{font:16px Geist,system-ui;min-height:50px;padding:12px 14px;background:var(--input,#f6f5f1);color:var(--ink,#15161a);border:1px solid var(--line,#e4e2db);border-radius:14px}.ds-field input:focus{outline:0;border-color:var(--accent,#17785a);box-shadow:0 0 0 3px #17785a2e}"
    },
    {
      "name": "Content surface",
      "kind": "card",
      "html": "<section class=\"ds-surface\">Your household journal</section>",
      "css": ".ds-surface{padding:20px;background:var(--surface,#fff);color:var(--ink,#15161a);border:1px solid var(--line-soft,#ecebe6);border-radius:28px;box-shadow:0 1px 2px #15161a0a,0 1px 3px #15161a08;font:15px Geist,system-ui}"
    },
    {
      "name": "Couple chip",
      "kind": "badge",
      "html": "<span class=\"ds-couple\"><i>S</i><i>S</i></span>",
      "css": ".ds-couple{display:inline-flex}.ds-couple i{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#5d5cdc;color:#fff;font:650 12px Geist,system-ui;font-style:normal;box-shadow:0 0 0 2px #fff}.ds-couple i+i{margin-left:-9px;background:#8f8ee6}"
    },
    {
      "name": "Dock",
      "kind": "nav",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Home</button><button>Sheets</button><button>Settle</button><button>Settings</button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,1fr);padding:6px;height:68px;border-radius:26px;background:#ffffffcc;border:1px solid #15161a12;backdrop-filter:blur(24px) saturate(1.8);box-shadow:0 2px 8px #15161a0f,0 16px 40px #15161a24}.ds-nav button{border:0;border-radius:20px;background:transparent;color:#8a8d95;font:550 11px Geist,system-ui;min-height:44px}.ds-nav button[aria-current]{background:#ecebe5;color:#15161a}"
    }
  ],
  "narrative": {
    "overview": "A warm, ink-on-paper household ledger. Each couple owns a colour that marks people everywhere; green and amber describe money; one strong surface per screen.",
    "keyCharacteristics": [
      "Ink on warm paper",
      "Couple identity colours",
      "Amounts set in parts",
      "Native bottom sheets and dock",
      "Light and dark themes"
    ]
  }
}
